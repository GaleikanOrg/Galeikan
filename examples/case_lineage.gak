requires { case.write }
import std.binary

let original: Source = binary.snapshot(binary.from_hex("00 11 22 33 44"))
let header: Source = binary.view(original, 1, 3)
let variant: Source = binary.patch(header, 1, binary.from_hex("ff"))
let field: Source = binary.view(variant, 1, 2)

impact binary.deep(field, 0, "u16le")
impact binary.diff(header, variant, 8)
