fn severity(score: i64) -> str = if score >= 90 { "critical" }
    else if score >= 70 { "high" }
    else if score >= 40 { "medium" }
    else { "low" }

print severity(95)
print severity(75)
print severity(45)
print severity(10)
print if true { 10 } else if false { 20 } else { 30 } + 1
print if false { 1 / 0 } else if true { 7 } else { 1 / 0 }
