import std.iter

fn classify(score: i64) -> str {
    if score >= 90 {
        return "critical"
    }
    if score >= 50 {
        return "review"
    }
    return "low"
}

fn first_target() -> i64 {
    for index in iter.range(5) {
        if index == 3 {
            return index
        }
    }
    return -1
}

fn countdown(value: i64) -> i64 {
    var current: i64 = value
    while current > 0 {
        if current == 2 {
            return current
        }
        current = current - 1
    }
    return 0
}

print classify(95)
print classify(55)
print classify(10)
print first_target()
print countdown(4)
print countdown(1)
